{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/mira",    "destination": "/features/mira",    "permanent": true },
    { "source": "/waas",    "destination": "/features/waas",    "permanent": true },
    { "source": "/billing", "destination": "/features/billing", "permanent": true },
    { "source": "/radius",  "destination": "/features/radius",  "permanent": true },
    { "source": "/portal",  "destination": "/features/portal",  "permanent": true },
    { "source": "/noc",     "destination": "/features/noc",     "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
